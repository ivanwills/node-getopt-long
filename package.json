{
  "author": "Ivan Wills <ivan.wills@gmail.com>",
  "name": "node-getopt-long",
  "description": "Sophisticated command line argument parser",
  "version": "1.0.0-0",
  "license": "GPL-3.0+",
  "keywords": [
    "commandline",
    "argument",
    "passing"
  ],
  "node": ">=0.10",
  "man": {},
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "commonjs",
  "files": [
    "lib",
    "index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanwills/node-getopt-long.git"
  },
  "bugs": "https://github.com/ivanwills/node-getopt-long/issues",
  "dependencies": {
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/underscore": "^1.13.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  },
  "readmeFilename": "README.md",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint index.js \"*.config.mjs\" && npm run typecheck",
    "lint-fix": "eslint --fix index.js \"*.config.mjs\"",
    "test": "jest --coverage",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "*"
  }
