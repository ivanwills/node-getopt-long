{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "outDir": "lib",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "examples/**/*.ts"],
  "exclude": ["lib", "node_modules"]
}
